theorem hNewRat_json : hNewRat = jsonMinorant := by decide +kernel

theorem hNew_json (t : ℝ) :
    hNew t = ∑ i ∈ Finset.range 21, ((jsonMinorant.getD i 0 : ℚ) : ℝ) * t ^ i := by
  rw [← hNewRat_json]; rfl

/-- The 1e-60 shift, both sides as explicit JSON-coefficient sums (L2's `minorantRat` is the
original near-sharp-d10 minorant verbatim, L2 review). -/
theorem shift_json {t : ℝ} (h1 : -1 ≤ t) (h2 : t ≤ 1) :
    ∑ i ∈ Finset.range 21, ((jsonMinorant.getD i 0 : ℚ) : ℝ) * t ^ i ≤
      ∑ i ∈ Finset.range 21, ((Bernstein.minorantRat.getD i 0 : ℚ) : ℝ) * t ^ i - 1 / 10 ^ 60 := by
  rw [← hNew_json, ← Bernstein.minorant_eq_sum]
  exact hNew_le_minorant_sub h1 h2

/-! ### (2) gaps, in Codex's radius bracket and with the contacts written out -/

theorem exterior_pin {r : ℝ} (hr1 : (radiusLower : ℝ) ≤ r) (hr2 : r ≤ (radiusUpper : ℝ)) {t : ℝ}
    (ht1 : -1 + 1 / 10000 ≤ t) (ht2 : t ≤ 5593 / 10000)
    (hw : ∀ j : Fin 6, 1 / 10000 ≤
      |t - (![r ^ 2 / 2 - 1, -r, -1 / 2, 2 * r ^ 2 - 1, 1 - 3 * r ^ 2 / 2, r / 2] : Fin 6 → ℝ) j|) :
    hNew t + 1 / 10 ^ 46 ≤ SDP.coulombPotential t := by
  have h := exterior_gap_new' hr1 hr2 ht1 ht2 hw
  rw [Bernstein.phi_eq (by linarith)] at h
  exact h

theorem refined_pin {r : ℝ} (hr1 : (radiusLower : ℝ) ≤ r) (hr2 : r ≤ (radiusUpper : ℝ)) {t : ℝ}
    (ht1 : -3 / 4 ≤ t) (ht2 : t ≤ 5593 / 10000)
    (hw : ∀ j : Fin 6, 1 / 100000000 ≤
      |t - (![r ^ 2 / 2 - 1, -r, -1 / 2, 2 * r ^ 2 - 1, 1 - 3 * r ^ 2 / 2, r / 2] : Fin 6 → ℝ) j|) :
    hNew t + 1 / 10 ^ 33 ≤ SDP.coulombPotential t := by
  have h := refined_gap_new' hr1 hr2 ht1 ht2 hw
  rw [Bernstein.phi_eq (by linarith)] at h
  exact h

theorem minorant_pin {t : ℝ} (h1 : -1 ≤ t) (h2 : t < 1) :
    hNew t + 1 / 10 ^ 60 ≤ SDP.coulombPotential t := by
  have h := hNew_add_le_phi h1 h2
  rw [Bernstein.phi_eq h2] at h
  exact h

/-! ### (3) LP: the Horner identity Codex still needs, and the end-to-end use -/

theorem hm_cov (t : ℝ) :
    Bernstein.polyEval covarianceNumerators t / covarianceDenominator =
      LPConcrete.covarianceMinorant t := by
  have e1 : covarianceNumerators = LPLinkage.covarianceNumerators := rfl
  have e2 : covarianceDenominator = LPLinkage.covarianceDenominator := rfl
  rw [e1, e2, LPLinkage.covariance_horner_eq, LPConcrete.covarianceMinorant, legendreExpansion,
    LPConcrete.covarianceDegrees]
  rw [Finset.sum_insert, Finset.sum_insert, Finset.sum_insert, Finset.sum_insert,
    Finset.sum_singleton]
  · simp only [LPConcrete.covarianceCoefficient]
    ring
  all_goals decide

theorem hm_sep (t : ℝ) :
    Bernstein.polyEval separationNumerators t / separationDenominator =
      LPConcrete.separationMinorant t := by
  have e1 : separationNumerators = LPLinkage.separationNumerators := rfl
  have e2 : separationDenominator = LPLinkage.separationDenominator := rfl
  rw [e1, e2, LPLinkage.separation_horner_eq, LPConcrete.separationMinorant, legendreExpansion,
    LPConcrete.separationDegrees]
  rw [Finset.sum_insert, Finset.sum_insert, Finset.sum_insert, Finset.sum_insert,
    Finset.sum_insert, Finset.sum_insert, Finset.sum_insert, Finset.sum_singleton]
  · simp only [LPConcrete.separationCoefficient]
    ring
  all_goals decide

theorem rv_covariance (x : Configuration) (hx : IsSphereConfiguration x)
    (henergy : coulombEnergy x ≤ LPConcrete.energyCutoff) :
    covarianceDeviation x < 1 / 4 :=
  LPConcrete.covariance_lt_quarter x hx henergy (hminor_cov _ hm_cov)

theorem rv_separation (x : Configuration) (hx : IsSphereConfiguration x)
    (henergy : coulombEnergy x ≤ LPConcrete.energyCutoff) (i j : Fin 9) (hij : i ≠ j) :
    inner ℝ (x i) (x j) < 5593 / 10000 :=
  LPConcrete.inner_lt_separation x hx henergy (hminor_sep _ hm_sep)
    (htail_sep _ LPConcrete.energyCutoff LPConcrete.separationBound rfl rfl hm_sep) i j hij

/-! ### (4) Integration: hbound is literally the conclusion of factored_certificate_pair_bound
with `h := hNew`, henergy is `coulombEnergy`, hsep is `inner_lt_separation`. -/

example (x : Configuration) (e S : ℝ)
    (hfc : e - 36 * S ≤ pairSum (fun i j => hNew (inner ℝ (x i) (x j)))) :
    e - 36 * S ≤ pairSum (hpairNew x) := hfc

theorem rv_chain (x : Configuration) (hx : IsSphereConfiguration x) (r : CandidateParameter)
    (e S : ℝ) (henergy : coulombEnergy x ≤ e) (hcut : e ≤ LPConcrete.energyCutoff)
    (hfc : e - 36 * S ≤ pairSum (fun i j => hNew (inner ℝ (x i) (x j))))
    (hS : 36 * S < 1 / 10 ^ 46) :
    ∃ p : Equiv.Perm (Fin 9), ∀ a b,
      |inner ℝ (x (p a)) (x (p b)) - inner ℝ (candidate r a) (candidate r b)| ≤ 1 / 100000000 :=
  refined_relabel x hx r (coulombEnergy x) e (36 * S) le_rfl henergy hfc hS
    (fun i j hij => rv_separation x hx (henergy.trans hcut) i j (ne_of_lt hij))

