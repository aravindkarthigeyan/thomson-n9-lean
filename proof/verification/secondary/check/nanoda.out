theorem ThomsonN9.thomson_nine_complete : ThomsonN9.Challenge.CompleteTarget := _

def ThomsonN9.Challenge.CompleteTarget :
  Prop :=
  And ThomsonN9.Challenge.ParameterExistsUnique
    (And ThomsonN9.Challenge.GlobalOptimality ThomsonN9.Challenge.GlobalUniqueness)

def ThomsonN9.Challenge.ParameterExistsUnique :
  Prop :=
  ExistsUnique
    (fun (r : Real) =>
    And (LE.le (Rat.cast ThomsonN9.radiusLower) r)
      (And (LE.le r (Rat.cast ThomsonN9.radiusUpper)) (Eq (ThomsonN9.stationarity r) (OfNat.ofNat 0))))

def ThomsonN9.Challenge.GlobalOptimality :
  Prop :=
  forall (r : ThomsonN9.CandidateParameter) (x : ThomsonN9.Configuration),
  ThomsonN9.IsSphereConfiguration x → LE.le (ThomsonN9.coulombEnergy (ThomsonN9.candidate r))
    (ThomsonN9.coulombEnergy x)

def ThomsonN9.Challenge.GlobalUniqueness :
  Prop :=
  forall (r : ThomsonN9.CandidateParameter) (x : ThomsonN9.Configuration),
  ThomsonN9.IsSphereConfiguration x → Iff
    (Eq (ThomsonN9.coulombEnergy x) (ThomsonN9.coulombEnergy (ThomsonN9.candidate r)))
    (ThomsonN9.Congruent x (ThomsonN9.candidate r))

axiom propext {a b : Prop} : Iff a b → Eq a b

axiom Quot.sound.{u} {α : Sort u} {r : α → α → Prop} {a b : α} : r a b → Eq (Quot.mk r a) (Quot.mk r b)

axiom Classical.choice.{u} {α : Sort u} : Nonempty α → α

